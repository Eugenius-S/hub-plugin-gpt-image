#!/usr/bin/env python3
"""Картинки GPT Image через Codex CLI (инструмент каталога gpt-image): промпт, референсы, папка → PNG в папке.

    gpt-image --out <папка> [-i ref.png ...] [--n 1-4] [--name имя] [--size 1024x1024] "<промпт>"
    gpt-image --out <папка> --prompt-file prompt.md ...
    gpt-image --out <папка> --batch кадры.json [--jobs 1-4]

Картинки идут параллельно, по --jobs codex сразу (по умолчанию 3; владелец 13.10: кадр 1–3.5 мин, пачка из 10 по одному —
25 мин): --n 4 — четыре запуска codex, --batch — список картинок со своими промптами, образцами и именами
([{"prompt" | "prompt_file", "name", "images": [...], "size", "n"}]). Упёрлись в лимит подписки ChatGPT — недоделанные
ещё раз по одной, снова лимит — остальные не трогаем, причина в итоге.

Codex генерирует своим инструментом image_generation по подписке ChatGPT (вход — `codex login`, ключ API не нужен),
картинки уходят в OpenAI. Файлы — <имя>-1.png, <имя>-2.png… (занятые номера пропускаются, старое не затирается).
Итог — последняя строка JSON: {"files": [...]} (и "failed": [{"name", "reason"}], если часть не вышла). Codex — из GPT_IMAGE_CODEX, PATH или ~/.local/bin/codex; прокси из
окружения (HTTPS_PROXY) codex берёт сам. Генерация идёт минуты: сессия запускает это фоном.
Каждый запуск codex — в своём CODEX_HOME (GPT_IMAGE_HOME/runs/…, по умолчанию ~/.cache/gpt-image/codex-home): вход —
ссылкой на auth.json владельца, его общие правила (~/.codex/AGENTS.md) не мешают, картинки соседних запусков не видны.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
from concurrent.futures import ThreadPoolExecutor

TIMEOUT = 20 * 60
MODEL = "gpt-6-luna"    # владелец 13.10: GPT-6 Luna, effort medium (сам codex брал gpt-6.1-sol)
EFFORT = "medium"
JOBS, MAX_JOBS = 3, 4   # codex сразу: подписка ChatGPT держит несколько генераций; больше — чаще упор в лимит
STAGGER = 3             # с между запусками: codex обновляет вход при старте — не все разом
PAUSE = 20              # с после упора в лимит — перед повтором по одной
# 13.10: посреди пачки вход Codex сменили на другой аккаунт — у идущих «token could not be refreshed»; повтор берёт новый
LIMIT = re.compile(r"usage limit|rate.?limit|too many requests|429|quota|could not be refreshed", re.I)


def codex():
    for c in (os.environ.get("GPT_IMAGE_CODEX"), shutil.which("codex"), os.path.expanduser("~/.local/bin/codex")):
        if c and os.path.exists(c):
            return c
    sys.exit("gpt-image: нет codex — поставьте Codex CLI (или ChatGPT.app) и войдите: codex login")


def isolated():
    """Свой CODEX_HOME на каждый запуск или None (ссылку не сделать — Windows без прав; тогда обычный дом codex).
    09.10: общий ~/.codex/AGENTS.md требовал скиллы Foundation — codex через раз отказывался сохранять картинку.
    14.10: дом был один на все запуски — codex искал «свежий PNG» в общей generated_images и при параллельных
    генерациях из разных сессий клал в папку чужую картинку. Вход — ссылкой на auth.json владельца."""
    real = os.path.abspath(os.path.expanduser(os.environ.get("CODEX_HOME") or "~/.codex"))
    auth = os.path.join(real, "auth.json")
    root = os.path.abspath(os.path.expanduser(os.environ.get("GPT_IMAGE_HOME") or "~/.cache/gpt-image/codex-home"))
    if not os.path.isfile(auth) or root == real:
        return None
    try:
        runs = os.path.join(root, "runs")
        os.makedirs(runs, mode=0o700, exist_ok=True)
        home = tempfile.mkdtemp(prefix="run-", dir=runs)
        os.symlink(auth, os.path.join(home, "auth.json"))
        open(os.path.join(home, "config.toml"), "w").close()
    except OSError:
        return None
    return home


SETTLE = threading.Lock()


def settle(home):
    """Codex обновил вход и записал auth.json файлом вместо ссылки — свежий вход отдать владельцу:
    иначе у его codex остался бы старый, уже отозванный токен. Дом запуска — убрать."""
    link = os.path.join(home, "auth.json")
    with SETTLE:
        if os.path.isfile(link) and not os.path.islink(link):
            real = os.path.join(os.path.abspath(os.path.expanduser(os.environ.get("CODEX_HOME") or "~/.codex")), "auth.json")
            os.replace(link, real)
    shutil.rmtree(home, ignore_errors=True)


def take(home, path):
    """Картинку в папку кладёт скрипт, а не модель: её копия бралась «свежим PNG» где попало — при параллельных
    прогонах чужая картинка или файл, который ещё пишется (13.10: ручки вместо искр, 0 байт). Своя — только в доме
    этого запуска; нет её — нет и картинки."""
    own = []
    for root, dirs, files in os.walk(home):
        dirs[:] = [d for d in dirs if d not in ("skills", "plugins")]   # значки встроенных скиллов — не результат
        for f in files:
            p = os.path.join(root, f)
            if f.lower().endswith(".png") and os.path.getsize(p):
                own.append((os.path.getmtime(p), p))
    if not own:
        if os.path.exists(path):
            os.remove(path)   # модель что-то положила, а своей картинки нет — значит, не наша
        return
    tmp = path + ".part"
    shutil.copyfile(max(own)[1], tmp)
    os.replace(tmp, path)   # целиком и сразу: читающий не застанет полфайла


def names(out, base, n, taken):
    got, i = [], 1
    while len(got) < n:
        name = f"{base}-{i}.png"
        if name not in taken and not os.path.exists(os.path.join(out, name)):
            got.append(name)
            taken.add(name)
        i += 1
    return got


def task(prompt, files, refs, size):
    lines = [f"Generate {len(files)} image(s) with your image generation tool. Pass this prompt to the tool as is, "
             "without rewriting it:", "", prompt, ""]
    if refs:
        lines.append(f"Use the {len(refs)} attached image(s) as references, as the prompt describes.")
    if size:
        lines.append(f"Size: {size}.")
    lines += ["Save the results as PNG into the current directory under exactly these names: "
              + ", ".join(f"`{f}`" for f in files) + ".",
              "Do not create, change or delete any other file. Reply with the saved file names only."]
    return "\n".join(lines)


def reason(r, said):
    """Почему нет картинок (07.10: было только «не получилось»): истекло время; строки ошибок из вывода codex (лимит
    подписки, вход, сеть и прокси); его последнее сообщение; иначе код выхода."""
    if r is None:
        return f"codex не уложился в {TIMEOUT // 60} мин"
    errors = [x.strip() for x in (r.stderr or "").splitlines()
              if re.search(r"error|limit|unauthori|forbidden|refus|denied|polic|proxy|connect|timed? ?out|429|403|401",
                           x, re.I)]
    parts = errors[-2:] + ([said] if said and said not in errors else [])
    text = " · ".join(p for p in parts if p) or f"codex завершился с кодом {r.returncode}, без объяснения"
    return text[:600]


def run(job, out):
    """Один запуск codex — одна картинка. -> (файл или None, почему нет)."""
    last = tempfile.NamedTemporaryFile(prefix="gpt-image-", suffix=".txt", delete=False).name
    cmd = [codex(), "exec", "--skip-git-repo-check", "-C", out, "-s", "workspace-write", "-o", last,
           "-m", MODEL, "-c", f"model_reasoning_effort={EFFORT}"]
    for r in job["refs"]:
        cmd += ["-i", r]
    cmd += ["--", task(job["prompt"], [job["file"]], job["refs"], job["size"])]   # -i берёт несколько: без «--» съел бы промпт
    home = isolated()
    env = {**os.environ, "CODEX_HOME": home} if home else None
    path = os.path.join(out, job["file"])
    try:
        r = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=TIMEOUT, env=env)
        if home:
            take(home, path)
    except subprocess.TimeoutExpired:
        r = None
    finally:
        if home:
            settle(home)
    said = ""
    try:
        with open(last, encoding="utf-8") as f:
            said = f.read().strip()   # последнее слово codex: отказ модерации, «не смог» — его же словами
        os.remove(last)
    except OSError:
        pass
    return (path, "") if os.path.isfile(path) and os.path.getsize(path) else (None, reason(r, said))


def generate(jobs, out, width):
    """Все картинки, по width сразу. Упор в лимит — недоделанные по одной после паузы; снова лимит — стоп."""
    done = {}
    lock = threading.Lock()

    def one(i):
        got = run(jobs[i], out)
        with lock:
            done[i] = got

    with ThreadPoolExecutor(max_workers=width) as pool:
        for k in range(len(jobs)):
            if k and k < width:
                time.sleep(float(os.environ.get("GPT_IMAGE_STAGGER", STAGGER)))
            pool.submit(one, k)
    again = [i for i, (path, why) in sorted(done.items()) if not path and LIMIT.search(why)]
    if again and width > 1:
        time.sleep(float(os.environ.get("GPT_IMAGE_PAUSE", PAUSE)))
        for n, i in enumerate(again):
            done[i] = run(jobs[i], out)
            if not done[i][0] and LIMIT.search(done[i][1]):
                for rest in again[n + 1:]:
                    done[rest] = (None, done[i][1])
                break
    return [done[i] for i in range(len(jobs))]


def where(p, base):
    """Путь из --batch — от папки этого файла, как его и писали."""
    return os.path.abspath(os.path.join(base, os.path.expanduser(p)))


def read_prompt(text, file):
    prompt = open(file, encoding="utf-8").read() if file else text
    if not (prompt or "").strip():
        sys.exit("gpt-image: нужен промпт")
    return prompt.strip()


def main():
    ap = argparse.ArgumentParser(prog="gpt-image")
    ap.add_argument("prompt", nargs="?")
    ap.add_argument("--prompt-file")
    ap.add_argument("--out", required=True)
    ap.add_argument("-i", "--image", action="append", default=[])
    ap.add_argument("--n", type=int, default=1)
    ap.add_argument("--name", default="image")
    ap.add_argument("--size")
    ap.add_argument("--batch")
    ap.add_argument("--jobs", type=int, default=JOBS)
    a = ap.parse_args()
    if a.batch:
        with open(os.path.expanduser(a.batch), encoding="utf-8") as f:
            items = json.load(f)
        if not isinstance(items, list) or not items:
            sys.exit("gpt-image: --batch — JSON-список картинок")
        base = os.path.dirname(os.path.abspath(os.path.expanduser(a.batch)))
    else:
        base = os.getcwd()
        items = [{"prompt": a.prompt, "prompt_file": a.prompt_file, "images": a.image, "n": a.n, "name": a.name,
                  "size": a.size}]
    out = os.path.abspath(os.path.expanduser(a.out))
    jobs, taken = [], set()
    for it in items:
        prompt = read_prompt(it.get("prompt"), it.get("prompt_file") and where(it["prompt_file"], base))
        refs = [where(r, base) for r in it.get("images") or []]
        missing = [r for r in refs if not os.path.isfile(r)]
        if missing:
            sys.exit("gpt-image: нет референса: " + ", ".join(missing))
        n = max(1, min(4, int(it.get("n") or 1)))
        jobs += [{"prompt": prompt, "refs": refs, "size": it.get("size") or a.size, "file": f}
                 for f in names(out, it.get("name") or "image", n, taken)]
    os.makedirs(out, exist_ok=True)
    got = generate(jobs, out, max(1, min(MAX_JOBS, a.jobs, len(jobs))))
    made = [path for path, _ in got if path]
    failed = [{"name": j["file"], "reason": why} for j, (path, why) in zip(jobs, got) if not path]
    if not made:
        sys.exit(f"gpt-image: картинок не получилось — {failed[0]['reason']}")
    print(json.dumps({"files": made, **({"failed": failed} if failed else {})}, ensure_ascii=False))


if __name__ == "__main__":
    main()
